# =====================================================================
# Sistema de comparação de propostas — SP Águas
# Copie para ".env" (mesma pasta do docker-compose.yml) e troque o que está marcado "troque".
# O ".env" NUNCA vai para o Git.
# =====================================================================

# ---------- Acesso ----------
APP_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ADMIN_EMAIL=admin@spaguas.sp.gov.br
ADMIN_SENHA_INICIAL=troque-esta-senha          # usada só para criar o primeiro administrador
APP_ORIGENS_PERMITIDAS=http://localhost:8080,http://localhost:5173
API_PORTA=3001

# ---------- Banco da aplicação (PostgreSQL) ----------
POSTGRES_USER=licitacoes
POSTGRES_PASSWORD=troque
POSTGRES_DB=licitacoes
# Rodando a API fora do Docker (npm run dev), use:
# DATABASE_URL=postgresql://licitacoes:troque@localhost:5432/licitacoes
# Deixe DATABASE_URL vazio para usar o banco em memória (só para testes; os dados somem ao reiniciar).

# ---------- New API (gateway das IAs) ----------
NEWAPI_DB_PASSWORD=troque
NEWAPI_TOKEN=sk-token-criado-no-painel-do-new-api
# Fora do Docker: NEWAPI_BASE_URL=http://localhost:3000/v1

# ---------- Regras de dados por IA ----------
# Aliases que só podem receber documentos PÚBLICOS (edital, TR). Proposta nunca vai para eles.
ALIASES_SO_DOCUMENTOS_PUBLICOS=ia-leve
# Aliases de nuvem: proposta só vai para eles mascarada (CPF, RG, telefone, e-mail, dados bancários).
ALIASES_NUVEM=ia-leve,ia-forte

# ---------- Rotas: tarefa = principal,reserva ----------
ROTA_E2_METADADOS=ia-leve,ia-media             # requisitos em texto corrido do edital/TR
ROTA_E3_REQUISITOS=ia-media,ia-forte           # tipificar as linhas do TR
ROTA_E4_PROPOSTA=ia-media,ia-forte             # extrair a proposta
ROTA_E5_PARES_DUVIDOSOS=ia-forte               # de-para quando a rede neural não tem certeza
ROTA_E6_TEXTO_LIVRE=ia-forte                   # julgamento de requisitos descritivos
E6_SEGUNDA_OPINIAO=ia-media                    # divergência entre as duas -> REVISAR

# ---------- Limites por alias ----------
LEVE_MAX_CONCURRENT=2
LEVE_RPM=10
LEVE_RPD=1000                                  # confira o limite atual do plano gratuito
MEDIA_MAX_CONCURRENT=1                         # notebook só com CPU: uma chamada por vez
FORTE_MAX_CONCURRENT=3
PAUSA_APOS_ERRO_SEGUNDOS=60
TIMEOUT_LEVE_SEGUNDOS=60
TIMEOUT_MEDIA_SEGUNDOS=300
TIMEOUT_FORTE_SEGUNDOS=120
TENTATIVAS_JSON_INVALIDO=2

# ---------- Critério da análise ----------
# Padrão para pregões novos (dá para mudar em cada pregão, na Etapa 04):
#   false = informação ausente na proposta vira NÃO COMPROVADO (cabe diligência)
#   true  = informação ausente na proposta vira NÃO ATENDE ("faltante")
AUSENCIA_COMO_NAO_ATENDE=false
# Cidade usada no fecho dos textos de recusa e de diligência ("São Paulo, 21 de outubro de 2026.")
LOCAL_TEXTOS=São Paulo

# ---------- Extração ----------
E3_LINHAS_POR_LOTE=15
CAPITULOS_GERAIS_PALAVRAS=REQUISITOS DA CONTRATACAO,MODELO DE EXECUCAO,PREENCHIMENTO DA PROPOSTA
CAPITULOS_HABILITACAO_PALAVRAS=HABILITACAO,CRITERIOS DE SELECAO

# ---------- IA local e rede neural de de-para (Ollama, dentro do Docker deste projeto) ----------
OLLAMA_MODELO_LOCAL=qwen3.5:4b                 # modelo baixado para a frente ia-media
EMBEDDINGS_MODELO=bge-m3                       # rede neural do de-para
# Fora do Docker (npm run dev), use: OLLAMA_URL=http://localhost:11434
LIMIAR_DEPARA=0.55

# ---------- Arquivos e OCR ----------
MAX_PDF_MB=25
OCR_ATIVO=true
OCR_IDIOMA=por
PDF_WORKER_TIMEOUT_SEGUNDOS=180

# ---------- E-mail (opcional) ----------
# Preencha com: powershell -ExecutionPolicy Bypass -File .\configurar-email.ps1
# Sem SMTP_HOST, "esqueci a senha" e os cadastros passam só pelo administrador (menu Usuários).
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_NOME_REMETENTE=SP Águas – Análise de Propostas
SMTP_IGNORAR_CERTIFICADO=false
EMAIL_AVISOS_ADMIN=
APP_URL_PUBLICA=http://localhost:8080

# ---------- Monitor de segurança (menu Segurança) ----------
# Bloqueia automaticamente o IP com muitos eventos graves (força bruta, injeção, varredura).
# O acesso local (este computador) nunca é bloqueado automaticamente.
SEGURANCA_BLOQUEIO_AUTOMATICO=true
SEGURANCA_LIMITE_EVENTOS=3
SEGURANCA_MINUTOS_BLOQUEIO=60
# IPs que nunca são bloqueados automaticamente (separe por vírgula)
SEGURANCA_IPS_CONFIAVEIS=
SEGURANCA_DIAS_HISTORICO=90
SEGURANCA_AVISO_EMAIL=true
